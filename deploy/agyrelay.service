[Unit]
Description=agyrelay: OpenAI-compatible API for Antigravity accounts
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
User=agyrelay
Group=agyrelay
ExecStart=/usr/local/bin/agyrelay serve -config /etc/agyrelay.json
Restart=on-failure
RestartSec=5s
# SIGTERM goes to agyrelay only; it closes its agy workers itself. Whatever
# is left when it exits is killed.
KillMode=mixed

StateDirectory=agyrelay
StateDirectoryMode=0700
UMask=0077

# agy writes only below the data dir (account HOME directories) and runs
# the patched copy from there; it creates no namespaces (traced, 1.5.3).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
